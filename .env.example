# TLH Engine local secrets & overrides. Git-ignored: never commit this file.
# Edit here or in the app: Settings > YANG (AI co-pilot) writes these values and reconfigures YANG immediately.

# --- Required for YANG (AI co-pilot, pop-up, agent) ---
ANTHROPIC_API_KEY=

# --- YANG model & effort ---
# Models: claude-opus-5 (default), claude-sonnet-5 (cheaper), claude-fable-5-1 (most capable)
TLH_AI_MODEL=claude-opus-5
# Effort: low | medium | high | xhigh | max
TLH_AI_EFFORT=high
# Max output tokens per turn
TLH_AI_MAX_TOKENS=16000

# --- Data ---
# FRED API key (optional; Norgate's Economic database is used by default for macro series)
FRED_API_KEY=
# Norgate watchlist used as the fit universe and default benchmark
TLH_UNIVERSE=S&P 500
TLH_BENCHMARK=S&P 500
# First date of price history pulled into snapshots
TLH_PRICE_START=2015-01-01

# --- Paths ---
# Runtime data directory (SQLite DB, Parquet snapshots, models, runs, exports). Default: <app folder>/var
# TLH_VAR_DIR=C:\path\to\var
ar
